# ── 1688影片工廠環境變數（本機放 .env；上線時到 Vercel → Settings → Environment Variables 逐一填）──

# Supabase（與其他系統共用同一個專案；本系統資料表都是 vf_ 前綴）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# 登入 cookie 簽章金鑰（一串隨機長字；正式站和本機用不同的）
SESSION_SECRET=vf-換一串隨機字

# OpenAI（AI 寫文案、畫圖、配音、聽打）
OPENAI_API_KEY=sk-proj-xxxxxxxx

# 阿里雲百煉（萬相 Wan 3.0 短劇、照片開口說話；沒有就先留空）
DASHSCOPE_API_KEY=
